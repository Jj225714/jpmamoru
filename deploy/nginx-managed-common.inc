# Same-origin authenticated service. Upstream secrets are injected by Python, never Nginx/browser.
access_log off;
error_log /var/log/nginx/aoweisi-managed-error.log crit;
limit_req zone=aoweisi_managed_requests burst=12 nodelay;
limit_req_status 429;
limit_conn aoweisi_managed_connections 12;
limit_conn_status 429;
proxy_http_version 1.1;
proxy_pass_request_headers off;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header Origin $http_origin;
proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
proxy_set_header Cookie $http_cookie;
proxy_set_header X-Managed-Principal $http_x_managed_principal;
proxy_set_header Content-Type $content_type;
proxy_set_header Accept $http_accept;
proxy_set_header Connection "";
proxy_connect_timeout 5s;
proxy_read_timeout 610s;
proxy_send_timeout 60s;
send_timeout 610s;
client_body_timeout 60s;
proxy_next_upstream off;
proxy_buffering off;
proxy_request_buffering on;
proxy_cache off;
proxy_redirect off;
gzip off;
add_header Cache-Control "no-store" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
